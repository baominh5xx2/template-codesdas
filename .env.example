# The skeleton boots without external configuration.
# Set APP_MODE=live only after a live backend is implemented and configured.
# APP_MODE=live
# DATABASE_URL=postgres://starter:starter@localhost:5432/starter
# SESSION_SECRET=replace-with-at-least-32-characters-for-local-development

# Multimodal gateway: text/search/image/video/TTS/STT/embeddings (src/adapters/gateway)
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://api.thucchien.ai
# MEDIA_DIR=.data/media

# The skeleton boots without external configuration.
# Set APP_MODE=live only after a live backend is implemented and configured.
# APP_MODE=live
# DATABASE_URL=postgres://starter_app:YOUR_GENERATED_APP_DB_PASSWORD@127.0.0.1:55432/starter
# SESSION_SECRET=replace-with-at-least-32-characters-for-local-development

# Multimodal gateway: text/search/image/video/TTS/STT/embeddings (src/adapters/gateway)
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://api.thucchien.ai
# MEDIA_DIR=.data/media

# Chat Model (C01) - AI Thực chiến: only the BTC Gateway is allowed.
# Copy these lines to .env.local and paste the team key (THUCCHIEN_API_KEY) there; never commit it.
# Default to the small/cheap model; switch to deepseek-v4-pro / gpt-6.1-sol only for hard tasks.
# CHAT_MODEL_BASE_URL=https://api.thucchien.ai/v1
# CHAT_MODEL_ID=deepseek-flash
# CHAT_MODEL_API_KEY=

# Docker stack: bun run docker:setup && bun run docker:up
# Compose credentials and port overrides live only in ignored .env.docker.

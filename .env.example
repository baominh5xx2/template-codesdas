# The skeleton boots without external configuration.
# Set APP_MODE=live only after a live backend is implemented and configured.
# APP_MODE=live
# DATABASE_URL=postgres://starter_app:YOUR_GENERATED_APP_DB_PASSWORD@127.0.0.1:55432/starter
# SESSION_SECRET=replace-with-at-least-32-characters-for-local-development

# Local Chat Model (C01)
# CHAT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_MODEL_ID=llama3.2
# CHAT_MODEL_API_KEY=

# Docker stack: bun run docker:setup && bun run docker:up
# Compose credentials and port overrides live only in ignored .env.docker.

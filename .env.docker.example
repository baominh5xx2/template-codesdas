# Copy/generate via bun run docker:setup. Never commit .env.docker.
APP_PORT=3100
POSTGRES_PORT=55432
MCP_PORT=18080
POSTGRES_PASSWORD=GENERATE_LOCALLY
APP_DB_PASSWORD=GENERATE_LOCALLY
MCP_DB_PASSWORD=GENERATE_LOCALLY
MCP_AUTH_TOKEN=GENERATE_LOCALLY
SESSION_SECRET=GENERATE_LOCALLY


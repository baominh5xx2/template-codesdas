{
  "name": "hackathon-starter-kit",
  "version": "1.0.0",
  "description": "A minimal, isolated modular monolith starter for hackathon projects.",
  "engines": {
    "node": ">=24.0.0",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "check": "next typegen && tsc --noEmit && eslint .",
    "test": "vitest run",
    "domain:validate": "tsx scripts/validate-domains.ts",
    "build": "next build",
    "e2e": "playwright test",
    "chat:smoke": "tsx scripts/chat-smoke.ts",
    "docker:setup": "node scripts/setup-docker.mjs",
    "docker:up": "node scripts/docker.mjs up -d --build --wait --wait-timeout 180",
    "docker:infra": "node scripts/docker.mjs up -d --wait --wait-timeout 120 db mcp",
    "docker:down": "node scripts/docker.mjs down",
    "docker:status": "node scripts/docker.mjs ps",
    "docker:check": "node scripts/check-docker.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": ["esbuild", "unrs-resolver"],
  "type": "module",
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@ai-sdk/openai": "3.0.124",
    "@copilotkit/react-core": "1.77.0",
    "@copilotkit/runtime": "1.77.0",
    "ai": "6.0.300",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "29.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
